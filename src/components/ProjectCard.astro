---
interface Props {
  title: string;
  description: string;
  tags: string[];
  href?: string;
  linkLabel?: string;
}

const {
  title,
  description,
  tags,
  href,
  linkLabel = 'View project',
} = Astro.props;
---

<article class="project-card">
  <h3>{title}</h3>
  <p>{description}</p>
  <ul class="tag-list" aria-label={`${title} technologies and topics`}>
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
  {href && (
    <a class="text-link" href={href} target="_blank" rel="noreferrer">
      {linkLabel} <span aria-hidden="true">↗</span>
    </a>
  )}
</article>
