---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    title: 'AI Slop Dataset for Open-Source Triage',
    description:
      'Curated and normalized evidence-grounded cases of low-quality AI-assisted issue reports and pull requests, with a reproducible schema for claims, evidence, and outcomes.',
    tags: ['Software Security', 'Python', 'Open Source', 'Data Curation'],
  },
  {
    title: 'Security Evidence Review for AI-Agent Skills',
    description:
      'Designed and applied a four-level screening rubric to evaluate research evidence about malicious or vulnerable AI-agent skills and benchmark coverage.',
    tags: ['AI Agents', 'Security', 'Literature Review', 'Benchmark Analysis'],
  },
  {
    title: 'Next Project',
    description:
      'Replace this card with a class project, hackathon build, research artifact, or open-source contribution. Describe the problem, what you built, and one measurable result.',
    tags: ['Add', 'Your', 'Project'],
  },
];
---

<Layout
  title="Tianyi Wang | Computer Science & Mathematics"
  description="Tianyi Wang is a UW–Madison undergraduate studying computer science and mathematics, with interests in software security and AI-assisted software engineering."
>
  <header class="site-header">
    <nav class="container nav" aria-label="Primary navigation">
      <a class="brand" href="#top" aria-label="Tianyi Wang, home">TW</a>
      <ul>
        <li><a href="#about">About</a></li>
        <li><a href="#experience">Experience</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main id="main-content">
    <section id="top" class="hero container">
      <p class="eyebrow">Computer Science · Mathematics · Software Security</p>
      <h1>Hi, I’m Tianyi Wang.</h1>
      <p class="hero-copy">
        I am an undergraduate at the University of Wisconsin–Madison studying computer science and mathematics. I work on software security, AI-assisted software engineering, and evidence-grounded analysis of open-source development.
      </p>
      <div class="button-row">
        <a class="button primary" href="#projects">See my work</a>
        <a class="button secondary" href="mailto:twang736@wisc.edu">Email me</a>
      </div>
      <ul class="quick-links" aria-label="Profile links">
        <li><a href="https://github.com/twang736" target="_blank" rel="me noreferrer">GitHub ↗</a></li>
        <li><a href="mailto:twang736@wisc.edu">twang736@wisc.edu</a></li>
      </ul>
    </section>

    <section id="about" class="section container two-column">
      <div>
        <p class="section-label">About</p>
        <h2>I like turning broad technical concerns into testable questions.</h2>
      </div>
      <div class="prose">
        <p>
          My current interests sit at the intersection of software engineering and security: how AI-assisted code contributions fail, how evidence should be collected and evaluated, and how tools can help maintainers review noisy reports without overclaiming.
        </p>
        <p>
          I also enjoy mathematical reasoning, open-source work, and building systems that make complex information easier to inspect.
        </p>
      </div>
    </section>

    <section id="experience" class="section muted-section">
      <div class="container">
        <p class="section-label">Experience</p>
        <h2>Research and education</h2>

        <div class="timeline">
          <article>
            <div>
              <h3>University of Notre Dame</h3>
              <p class="role">Undergraduate Research Assistant · iSURE 2026 · S2E Research Lab</p>
            </div>
            <p class="date">May 2026 – Present</p>
            <p class="timeline-copy">
              Studying intelligent code assistants for software security, including AI-assisted open-source reports, pull-request quality, and security risks in agent skills.
            </p>
          </article>

          <article>
            <div>
              <h3>University of Wisconsin–Madison</h3>
              <p class="role">B.S. candidate · Computer Sciences and Mathematics</p>
            </div>
            <p class="date">Expected December 2027</p>
            <p class="timeline-copy">
              Coursework and projects in computer science, mathematics, statistics, and software development.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="projects" class="section container">
      <p class="section-label">Projects</p>
      <div class="section-heading-row">
        <h2>Selected work</h2>
        <p>Keep three to five strong projects here. Quality beats volume.</p>
      </div>
      <div class="project-grid">
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>
    </section>

    <section id="contact" class="section container contact-card">
      <div>
        <p class="section-label">Contact</p>
        <h2>Let’s talk about research, software, or a project.</h2>
      </div>
      <div class="button-row">
        <a class="button primary" href="mailto:twang736@wisc.edu">twang736@wisc.edu</a>
        <a class="button secondary" href="https://github.com/twang736" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-row">
      <p>© {new Date().getFullYear()} Tianyi Wang</p>
      <p>Built with Astro and deployed on GitHub Pages.</p>
    </div>
  </footer>
</Layout>
