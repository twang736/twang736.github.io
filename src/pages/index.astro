---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    title: 'AI Slop Dataset for Open-Source Triage',
    description:
      'Curated and normalized evidence-grounded cases of low-quality AI-assisted issue reports and pull requests, with a reproducible schema for claims, evidence, and outcomes.',
    tags: ['Software Security', 'Python', 'Open Source', 'Data Curation'],
  },
  {
    title: 'Security Evidence Review for AI-Agent Skills',
    description:
      'Designed and applied a four-level screening rubric to evaluate research evidence about malicious or vulnerable AI-agent skills and benchmark coverage.',
    tags: ['AI Agents', 'Security', 'Literature Review', 'Benchmark Analysis'],
  },
  {
    title: 'Alternating Sign Matrices',
    description:
      'Investigating algebraic and combinatorial operations on alternating sign matrices in UW–Madison’s Madison Experimental Mathematics Lab, with the goal of finding a natural way to combine two ASMs that extends permutation-matrix multiplication.',
    tags: ['Experimental Mathematics', 'Algebraic Combinatorics', 'Alternating Sign Matrices'],
    href: 'https://mxm.math.wisc.edu/fall-2026/',
    linkLabel: 'View MXM project',
  },
];
---

<Layout
  title="Tianyi Wang | Computer Science & Mathematics"
  description="Tianyi Wang is a UW–Madison undergraduate studying computer science and mathematics, working on AI security, AI-assisted software engineering, and experimental mathematics."
>
  <header class="site-header">
    <nav class="container nav" aria-label="Primary navigation">
      <a class="brand" href="#top" aria-label="Tianyi Wang, home">TW</a>
      <ul>
        <li><a href="#about">About</a></li>
        <li><a href="#experience">Experience</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main id="main-content">
    <section id="top" class="hero container">
      <p class="eyebrow">Computer Science · Mathematics · AI Security · Experimental Mathematics</p>
      <h1>Hi, I’m Tianyi Wang.</h1>
      <p class="hero-copy">
        I am an undergraduate at the University of Wisconsin–Madison studying computer science and mathematics. My current research spans AI security, AI-assisted software engineering, and experimental mathematics.
      </p>
      <div class="button-row">
        <a class="button primary" href="#projects">See my work</a>
        <a class="button secondary" href="mailto:twang736@wisc.edu">Email me</a>
      </div>
      <ul class="quick-links" aria-label="Profile links">
        <li><a href="https://github.com/twang736" target="_blank" rel="me noreferrer">GitHub ↗</a></li>
        <li><a href="mailto:twang736@wisc.edu">twang736@wisc.edu</a></li>
      </ul>
    </section>

    <section id="about" class="section container two-column">
      <div>
        <p class="section-label">About</p>
        <h2>Research across secure AI-assisted software and experimental mathematics.</h2>
      </div>
      <div class="prose">
        <p>
          I study computer science and mathematics at the University of Wisconsin–Madison. I am interested in problems where rigorous evidence, software systems, and mathematical structure meet—especially the reliability and security of AI-assisted software development.
        </p>
        <p>
          In the Security and Software Engineering (S2E) Lab at the University of Notre Dame, I work on empirical research involving AI-assisted open-source development, evidence-grounded triage of low-quality AI-generated contributions, and security evaluation of AI-agent skills and benchmarks.
        </p>
        <p>
          At UW–Madison’s Madison Experimental Mathematics Lab (MXM), I am part of the Fall 2026 Alternating Sign Matrices project. Our team studies the algebraic and combinatorial structure of alternating sign matrices and investigates natural operations that could generalize permutation-matrix multiplication.
        </p>
      </div>
    </section>

    <section id="experience" class="section muted-section">
      <div class="container">
        <p class="section-label">Experience</p>
        <h2>Research and education</h2>

        <div class="timeline">
          <article>
            <div>
              <h3>University of Notre Dame</h3>
              <p class="role">Undergraduate Research Assistant · Security and Software Engineering (S2E) Lab</p>
            </div>
            <p class="date">May 2026 – Present</p>
            <div class="timeline-copy">
              <p><strong>Project: A Curated AI Slop Dataset for Open-Source Software Triage</strong></p>
              <ul>
                <li>Manually reviewed 49 curl HackerOne reports and standardized 52 maintainer-validated AI-slop cases—49 vulnerability reports and 2 RPCS3 pull requests—using a six-field evidence codebook; contributed the records to a team corpus of 52 unique cases across 3 open-source projects.</li>
                <li>Designed a four-level screening rubric for malicious AI-agent skill evidence, classifying 31 papers as direct, partial, indirect, or unrelated; evaluated SkillLeakBench artifacts covering 520 affected skills and 1,708 issues for benchmark and detector-design utility.</li>
                <li>Co-built a 62-paper literature matrix on agentic software engineering by synthesizing 31 assigned studies and mapping 10 candidate research questions to prior work, identifying research gaps and refining the project scope.</li>
              </ul>
            </div>
          </article>

          <article>
            <div>
              <h3>Madison Experimental Mathematics Lab (MXM), UW–Madison</h3>
              <p class="role">Undergraduate Researcher · Alternating Sign Matrices</p>
            </div>
            <p class="date">Sep 2026 – Present</p>
            <div class="timeline-copy">
              <p><strong>Project: Alternating Sign Matrices</strong></p>
              <ul>
                <li>Investigating a natural way to combine two alternating sign matrices to produce another alternating sign matrix, motivated by the role of matrix multiplication for permutation matrices.</li>
                <li>Studying algebraic and combinatorial structure through examples and exploratory problem solving with a small undergraduate research team.</li>
                <li>Project mentor: Paul Terwilliger; graduate student mentor: Dhruv Kulshreshtha.</li>
              </ul>
            </div>
          </article>

          <article>
            <div>
              <h3>University of Wisconsin–Madison</h3>
              <p class="role">B.S. candidate · Computer Sciences and Mathematics</p>
            </div>
            <p class="date">Expected December 2027</p>
            <p class="timeline-copy">
              Coursework and projects in computer science, mathematics, statistics, and software development.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="projects" class="section container">
      <p class="section-label">Projects</p>
      <div class="section-heading-row">
        <h2>Selected work</h2>
        <p>Selected research and software projects.</p>
      </div>
      <div class="project-grid">
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>
    </section>

    <section id="contact" class="section container contact-card">
      <div>
        <p class="section-label">Contact</p>
        <h2>Let’s talk about research, software, or a project.</h2>
      </div>
      <div class="button-row">
        <a class="button primary" href="mailto:twang736@wisc.edu">twang736@wisc.edu</a>
        <a class="button secondary" href="https://github.com/twang736" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-row">
      <p>© {new Date().getFullYear()} Tianyi Wang</p>
      <p>Built with Astro and deployed on GitHub Pages.</p>
    </div>
  </footer>
</Layout>
